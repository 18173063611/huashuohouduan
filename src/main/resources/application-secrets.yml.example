# 使用方式：复制本文件为同目录下的 application-secrets.yml，填写真实密钥后启动应用。
# application-secrets.yml 已在 .gitignore 中，不要提交到 Git。
# 生产环境可改为仅使用环境变量：VOLCENGINE_TOS_ACCESS_KEY_ID、VOLCENGINE_TOS_SECRET_ACCESS_KEY（会覆盖下方同名字段）。
# 若不需要 TOS，可设环境变量 VOLCENGINE_TOS_ENABLED=false，或保持本文件不存在且关闭 enabled（需自行调配置）。

volcengine:
  # 以下 api-key / access-key 仅示例：请填写你在控制台获取的真实值
  ark:
    api-key: "在此填写 Ark API Key（用于大模型/图片等 Ark 调用）"
  image:
    api-key: "在此填写 图片生成 API Key（若与 Ark 共用可填同一值）"
  tts:
    access-key: "在此填写 TTS Access Key/Token"
  asr:
    access-key: "在此填写 ASR Access Key/Token"
  tos:
    access-key-id: "在此填写 Access Key ID"
    secret-access-key: "在此填写 Secret Access Key"

tikhub:
  api-key: "在此填写 tikhub api-key（若启用相关能力）"
